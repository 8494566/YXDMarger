<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Windows 集成认证，配置文件里没有任何数据库密码 -->
    <add name="PayCenter"
         connectionString="Data Source=127.0.0.1,1433;Initial Catalog=PayCenter;Integrated Security=SSPI;Application Name=PayWeb;Connect Timeout=10;Pooling=true;Max Pool Size=50;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ShopName" value="英雄岛充值中心" />

    <!-- 汇率：1 元 = 多少点券 / 多少金币 -->
    <add key="RatePointsPerYuan" value="10000" />
    <add key="RateGoldPerYuan" value="500000" />

    <!-- 单笔金额范围（元） -->
    <add key="MinYuan" value="1" />
    <add key="MaxYuan" value="10000" />

    <!-- 收款二维码：把你的支付宝收款码图片放到 C:\PayApp\qr\alipay.png 即可 -->
    <add key="AlipayQrImage" value="/pay/qr/alipay.png" />
    <add key="AlipayQrUrl" value="" />

    <!-- 下单防刷：同 IP 每分钟最多几次 -->
    <add key="OrderRateLimitPerMin" value="10" />

    <!-- 后台访问白名单，逗号分隔；支持 1.2.3.* 这种写法；留空=不限制 -->
    <add key="AdminAllowIps" value="" />
    <add key="AdminSessionMinutes" value="30" />

    <!-- 后台地址，会附在微信提醒里，点开就能确认。换域名/端口时改这里 -->
    <add key="AdminUrl" value="http://42.193.197.163:35179/pay/admin.aspx" />

    <!-- 充值礼包：GoodsID|名称|价格元|描述|数量 ；多个用分号隔开。删掉某项就下架 -->
    <add key="GiftPacks" value="89300|BOSS蛋礼包|10|20 个岛猪的蛋 + 20 个神龙的蛋|1;89301|货币礼包|50|200 个薄荷龙鳞 + 50 个金克拉|1" />
    <!-- 每个角色每个礼包限购几次 -->
    <add key="PackLimitPerActor" value="1" />
    <!-- 待支付的礼包订单多少分钟内算“占用名额”（超时自动释放，玩家可重新下单） -->
    <add key="PackPendingMinutes" value="30" />

    <!-- 微信到账提醒。token 不写这里，用 C:\PayApp\tools\set-notify.ps1 录入到 App_Data\notify.txt -->
    <add key="NotifyProvider" value="" />
    <add key="NotifyTimeoutMs" value="6000" />
  </appSettings>
  <!-- 打开系统默认强加密（TLS 1.2+），否则发往微信/Server酱 的 HTTPS 会失败 -->
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false" />
  </runtime>
  <system.web>
    <compilation targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" enableVersionHeader="false" maxRequestLength="64" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="zh-CN" uiCulture="zh-CN" />
    <customErrors mode="RemoteOnly" />
    <sessionState mode="InProc" timeout="30" cookieless="UseCookies" />
    <pages enableViewState="false" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <httpErrors errorMode="DetailedLocalOnly" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
